# PR3: Greedy and A* Search

import heapq

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('F', 2)],
    'D': [('G', 3)],
    'E': [('G', 1)],
    'F': [('G', 3)],
    'G': []
}

h = {
    'A': 5, 'B': 4, 'C': 3,
    'D': 2, 'E': 1, 'F': 2, 'G': 0
}


def greedy(start, goal):
    queue = [(h[start], start, [start])]
    visited = []

    while queue:
        _, node, path = heapq.heappop(queue)

        if node == goal:
            return path

        if node not in visited:
            visited.append(node)

            for n, cost in graph[node]:
                if n not in visited:
                    heapq.heappush(
                        queue, (h[n], n, path + [n])
                    )

    return None


def astar(start, goal):
    queue = [(h[start], 0, start, [start])]
    best = {start: 0}

    while queue:
        f, g, node, path = heapq.heappop(queue)

        if node == goal:
            return path, g

        if g != best[node]:
            continue

        for n, cost in graph[node]:
            new_g = g + cost

            if new_g < best.get(n, float('inf')):
                best[n] = new_g
                new_f = new_g + h[n]

                heapq.heappush(
                    queue, (new_f, new_g, n, path + [n])
                )

    return None, float('inf')


print("Greedy Path:", greedy('A', 'G'))

path, cost = astar('A', 'G')
print("A* Path:", path)
print("A* Cost:", cost)
